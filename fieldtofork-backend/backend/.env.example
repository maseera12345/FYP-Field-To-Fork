NODE_ENV=development
PORT=5000

# Local MongoDB (Compass / mongod running on your PC)
MONGO_URI=mongodb://127.0.0.1:27017/fieldtofork

# Use a long random string. Never commit the real .env file.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend (Vite) address, used for CORS and Socket.io
CLIENT_URL=http://localhost:5173

# Python AI service (MobileNetV2)
AI_SERVICE_URL=http://127.0.0.1:8000

# Image uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Weather provider key (added in the weather module)
WEATHER_API_KEY=
